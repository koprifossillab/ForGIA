# from DiaRUGA 34bdf21 (v0.20.0-3) deploy/test/env.template — 이름·경로·포트만 바꿨다 (P01 §3.1)
# /srv/ForGIA/test/.env 견본 (085). 운영은 `deploy/srv/env.template` 이다.
#
#   deploy/host/sync_test_to_srv.sh      # 없으면 이 견본에서 만들어 준다
#
# **운영 `.env` 와 반드시 달라야 하는 것이 셋이다.** 같아지면 테스트가 운영을
# 만진다 — `testdeploy.sh` 가 돌기 전에 그것을 검사하고, 걸리면 멈춘다.

# **사본이다.** 운영 DB(/srv/ForGIA/db/ForGIA.db)를 여기 적으면 안 된다 —
# 테스트에서 한 교정이 운영으로 들어간다. compose 도 운영 db/ 를 아예 마운트하지
# 않으므로, 잘못 적으면 파일을 못 찾아 **빈 DB 가 새로 생긴다**(더 조용한 고장이다).
FORGIA_DB=/srv/ForGIA/test/db/ForGIA.db

# 사진·산출물은 운영과 함께 본다 — 읽기만 하고, 썸네일 캐시는 경로로 키를 잡아
# 두 판이 같은 것을 만든다. **썸네일 생성 코드를 건드린 판을 미리 볼 때는
# 여기를 갈라야 한다** (안 그러면 운영 캐시에 새 판의 결과가 섞인다).
FORGIA_DATA_ROOT=/data3/ForGIA
FORGIA_THUMB_CACHE=/data3/ForGIA/.thumbcache

FORGIA_DEBUG=0

# **운영과 다른 키를 쓴다.** 오리진이 같아(172.16.116.98:80) 세션 쿠키를
# 공유하는데, 키까지 같으면 두 판의 세션이 서로 유효해진다.
#
# **`$` 를 넣지 않는다.** 이 파일은 compose 의 변수 치환에도 쓰여서, `$` 가
# 있으면 compose 가 그 자리를 변수로 읽고 조용히 다른 값이 들어간다.
#
#   python3 -c "import secrets,string; print(''.join(secrets.choice(
#       string.ascii_letters+string.digits+'!@%^&*(-_=+)[]{}') for _ in range(50)))"
FORGIA_SECRET_KEY=여기를_채울_것

FORGIA_HOSTS=

# **여기가 /ForGIA 이면 링크가 전부 운영으로 샌다.** nginx 가 /ForGIATest/ 을
# 떼고 넘기고, Django 는 링크를 만들 때만 이 값을 앞에 붙인다
# (deploy/nginx/ForGIATest-subpath.conf).
FORGIA_SCRIPT_NAME=/ForGIATest

# 미리 볼 판. `testdeploy.sh <판>` 이 이 줄만 제자리에서 고친다.
IMAGE_TAG=

# **여기가 운영이 아니라는 표시.** 값이 있으면 화면 전체에 빨간 워터마크가
# 대각선으로 뜬다 (viewer/context.py 머리말 · base.html 의 .envwm).
#
# 두 화면이 **같은 오리진에 같은 모양으로** 떠 있어 주소창 말고는 구분할 것이
# 없었다. 판 번호도 둘이 같을 때가 많다 — 테스트는 내보내기 직전 판을 거는
# 자리라 오히려 같은 것이 정상이다. 그 상태에서 테스트를 운영으로 알고 검토하면
# **사본에 한 교정이 아무 데도 안 남는다.**
#
# **운영 `.env` 에는 이 줄이 없다.** 거기 서면 운영 화면을 가린다.
FORGIA_ENV_LABEL=Test Server

# /healthz 의 사본 신선도 게이트가 읽는 자리. 테스트는 스스로 사본을 뜨지 않으므로
# 운영 백업 디렉토리를 **읽기만** 한다(mtime 만 본다). 안 적으면 컨테이너가 이미지
# 안을 보고 "사본이 없다" 며 degraded 를 낸다 — 그러면 smoke 가 멈춘다.
FORGIA_BACKUP_DIR=/data3/ForGIA/backup
FORGIA_BACKUP_MAX_AGE_H=3
