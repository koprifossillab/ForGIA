# ForGIA 뷰어 이미지 (P03).
#
# 파이프라인 이미지가 이것을 FROM 한다. 그래서 여기에는 둘이 공통으로 쓰는 것
# (코드 + Django)만 넣고 torch 는 넣지 않는다 — 뷰어 한 줄 고칠 때마다 6 GB 를
# 다시 굽지 않기 위한 경계다.
#
# 데이터(사진·산출물·DB)는 굽지 않는다. 전부 /data 로 마운트해서 본다.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 의존성을 코드보다 먼저 깐다 — 코드만 고쳤을 때 이 층을 다시 받지 않는다
#
# **pip 을 먼저 올린다** (006). 베이스 이미지에 든 pip 은 그 파이썬 판이 나올 때
# 묶인 것이라 베이스를 새로 받아도 안 올라간다(3.12 는 25.0.1 이었다). 26.1 이
# 악성 wheel·인덱스로 설치 경로 밖에 파일을 쓰는 결함들을 고친 판이다.
COPY requirements-web.txt ./
RUN pip install --upgrade "pip>=26.1" \
 && pip install -r requirements-web.txt

COPY . .

# 컨테이너는 1000:1000 으로 돈다 (compose 의 user:). root 로 돌면 ForGIA.db 의
# 소유자가 바뀌어 호스트의 backup_db.py·check_db.py 가 못 쓰게 된다.
# 이름 있는 사용자를 만들지 않고 숫자 uid 를 그대로 쓰므로, HOME 이 없어도
# 곤란하지 않도록 캐시 위치를 명시해 둔다.
ENV HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

EXPOSE 9090
