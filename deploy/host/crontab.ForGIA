# ForGIA 호스트 cron 조각 — paleoadmin 의 crontab 에 붙인다 (2026-09-21):
#
#   (crontab -l; cat deploy/host/crontab.ForGIA) | crontab -
#
# DiaRUGA 의 두 줄(:20 · 04:40)과 같은 규약이고 시각만 비껴 뒀다. 이 파일이 없던
# 사흘 동안 사본이 하나도 안 떠서 /healthz 가 degraded 를 내고 있었다.

# ForGIA DB 시간별 스냅샷 — .guides/web/data-safety.md §1 의 hourly track.
# 컨테이너 안(dbtool)에서 돈다 — DB 는 그 문 하나로만 들어간다(CLAUDE.md).
# 검증을 통과해야 채택하고, 실패하면 정리를 건너뛰고 DB 옆에 INTEGRITY_FAIL 을 세운다
# → /healthz 가 degraded 를 낸다. --keep 24 = 24시간 rolling. --note 로 뜬 것은 안 건드린다.
# 로그: /data3/ForGIA/logs/backup.log
25 * * * * /srv/ForGIA/bin/dbrun.sh backup_db.py --keep 24 >> /data3/ForGIA/logs/backup.log 2>&1

# ForGIA 일별 오프사이트 — 시간별 사본·사진·가중치를 NAS(/nfs/temp-share/ForGIA/backup)로.
# 살아 있는 DB 는 안 연다(사본 파일만 옮기고 NAS 쪽 사본을 mode=ro 로 검증) — 호스트 venv 로 돈다.
# dbtool 컨테이너에는 NAS 가 안 붙어 있다. NAS 가 hard 마운트라 timeout 으로 감싼다.
# 로그: /data3/ForGIA/logs/nas-sync.log
10 5 * * * cd /srv/ForGIA && timeout 1800 /home/paleoadmin/venv/ForGIA/bin/python /srv/ForGIA/scripts/sync_backup_nas.py --newest-only --prune --photos >> /data3/ForGIA/logs/nas-sync.log 2>&1
