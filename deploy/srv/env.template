# /srv/ForGIA/.env 견본 (P03). 복사해서 채운다.
#
#   cp deploy/srv/env.template /srv/ForGIA/.env
#
# 컨테이너 안팎의 경로가 같으므로 이 값들은 호스트의 저장소 .env 와 같아도 된다.

# 지금 도는 이미지 판. 배포 스크립트가 이 줄만 제자리에서 고친다.
IMAGE_TAG=v0.1.0

# DB. 디렉토리째 마운트하는 그 안에 있다.
FORGIA_DB=/srv/ForGIA/db/ForGIA.db

# 사진과 산출물. 아래에 photos/<촬영일>/<슬라이드>/ · stacked/ · out/ 이 있다.
FORGIA_DATA_ROOT=/data3/ForGIA

# 썸네일 캐시. 이미지 안(/app)은 uid 1000 으로 못 쓴다.
FORGIA_THUMB_CACHE=/data3/ForGIA/.thumbcache

# 백업 사본이 놓인 곳. **/healthz 가 이것을 읽어 사본의 나이를 보고한다** —
# 안 주면 컨테이너가 이미지 안(/app/backup)을 보고 "사본이 없다" 고 말한다.
# 호스트의 backup_db.py 와 같은 값이어야 한다.
FORGIA_BACKUP_DIR=/data3/ForGIA/backup

# 가장 새 스냅샷이 이보다 오래되면 /healthz 가 degraded 를 낸다.
# 시간별로 뜨므로(cron :20) 3 이면 두 번 연달아 걸러야 울린다.
FORGIA_BACKUP_MAX_AGE_H=3

# 운영이므로 끈다.
FORGIA_DEBUG=0

# 반드시 바꿀 것. 이 뷰어는 인증이 없어 사내망 전용이지만 그래도 기본값으로 두지 않는다.
FORGIA_SECRET_KEY=CHANGE-ME

# 접속 코드 (web/viewer/gate.py). **비워 두면 잠그지 않는다.** 넣으면 코드를 모르는
# 브라우저는 잠금 화면으로 가고, 한 번 넣은 브라우저는 다시 묻지 않는다.
# 바꾸면 이미 들어온 브라우저도 모두 다시 묻는다. `$` 를 넣지 않는다(compose 치환).
FORGIA_GATE_CODE=

# settings.py 의 ALLOWED_HOSTS 에 더해진다. 보통 비워 둔다.
FORGIA_HOSTS=

# 서브경로 배포. nginx 가 80 의 /ForGIA/ 을 떼고 넘기므로 Django 는 링크를 만들 때만
# 이 값을 앞에 붙인다 (deploy/nginx/ForGIA-subpath.conf). :9090 으로 직접 들어와도
# 같은 값이 붙는데, 앞단이 둘 다 같은 컨테이너를 보므로 문제가 되지 않는다 —
# 다만 9090 으로 붙으면 주소가 :9090/ForGIA/... 이 된다.
FORGIA_SCRIPT_NAME=/ForGIA

# 파이프라인 이미지 판. **IMAGE_TAG 와 따로다** — 뷰어는 자주 굽고 파이프라인은
# 거의 안 굽는다. 하나로 묶었다가 뷰어 판을 올릴 때마다 폴러가 멈췄다.
PIPELINE_TAG=v0.1.0
