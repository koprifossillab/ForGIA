# 장비마다 다른 값. `.env` 로 복사해서 채운다 (`.env` 는 gitignore).
#
# 컨테이너는 compose 가 환경변수를 직접 주므로 이 파일이 필요 없다.
# 이 파일은 **호스트에서 스크립트를 그냥 돌릴 때**를 위한 것이다 —
# check_db.py 처럼 사진 파일이 있는지 보는 것들이 데이터 위치를 알아야 한다.

# 사진과 산출물이 있는 곳. 저장소가 아니라 큰 디스크에 둔다 (DiaRUGA P03).
# 이 아래에 photos/<촬영일>/<슬라이드>/ · stacked/ · out/ 이 있다.
FORGIA_DATA_ROOT=/data3/ForGIA

# DB 위치. 배포 디렉토리에 있다 (phyloserver 와 같은 /srv/<앱>/ 규약).
FORGIA_DB=/srv/ForGIA/db/ForGIA.db

# 백업 사본. 큰 디스크에 둔다.
FORGIA_BACKUP_DIR=/data3/ForGIA/backup

# 뷰어를 이 이름/주소로도 열 때 추가한다 (settings.py 의 ALLOWED_HOSTS 에 더해진다).
#FORGIA_HOSTS=

# 운영으로 돌릴 때 반드시 채운다.
#FORGIA_SECRET_KEY=
#FORGIA_DEBUG=0

# 오프사이트 백업 (NAS). 검증된 스냅샷만 밀어 둔다.
FORGIA_NAS_BACKUP_DIR=/nfs/temp-share/ForGIA/backup

# 가장 새 스냅샷이 이보다 오래되면 /healthz 가 degraded 를 낸다 (신선도 게이트).
# 시간별로 뜨므로(cron :20) 3 이면 **두 번 연달아 걸러야** 울린다. 잡는 것은 두
# 가지 — 시간별 백업이 멈췄거나, 무결성 게이트가 채택을 막고 있거나.
# **손으로 돌리는 장비에서는 켜지 말 것** — 늘 울리고, 늘 울리는 경보는 안 보게 된다.
FORGIA_BACKUP_MAX_AGE_H=3
